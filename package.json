{
  "name": "az-logistika-platformasi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "find src backend/src -name '*.test.ts' | xargs tsx --test && find octo-admin scripts -name '*.test.js' -o -name '*.test.mjs' | xargs node --test",
    "dev": "concurrently \"next dev --port 3001\" \"node octo-admin/index.js\" \"tsx backend/src/server.ts\"",
    "dev:ngrok": "bash scripts/ngrok-dev.sh",
    "backend:dev": "tsx backend/src/server.ts",
    "build": "next build",
    "backend:start": "tsx backend/src/server.ts",
    "start": "concurrently -n next,admin,backend -c cyan,yellow,green \"next start -p 3001 -H 0.0.0.0\" \"node octo-admin/index.js\" \"tsx backend/src/server.ts\"",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "prod:validate-env": "node scripts/validate-production-env.mjs",
    "prod:bootstrap-admin": "node scripts/bootstrap-production-admin.mjs",
    "prod:ensure-admin": "node scripts/ensure-postgres-admin.mjs",
    "db:import-legacy-sqlite": "node scripts/legacy-sqlite-import.mjs",
    "hosts:local": "bash scripts/setup-local-hosts.sh",
    "traefik:local": "bash scripts/traefik-local.sh",
    "traefik:local:down": "docker rm -f tranzit-traefik-local >/dev/null 2>&1 || true"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/leaflet": "^1.9.21",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "admin-lte": "^4.1.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "esbuild": "~0.28.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "framer-motion": "^12.42.2",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "next": "^15.0.3",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-phone-number-input": "^3.4.17",
    "react-share": "^5.3.0",
    "remixicon": "^4.9.1",
    "tailwind-merge": "^2.5.4",
    "timepicker-ui-react": "^1.4.0",
    "tsx": "^4.23.5",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
