<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold" style="color: #1e293b;">Səhifə Məzmunu</h4>
</div>

<% if (saved) { %>
    <div class="alert alert-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>Dəyişikliklər uğurla saxlandı.
    </div>
<% } %>
<% if (error) { %>
    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Saxlama zamanı xəta baş verdi.
    </div>
<% } %>

<!-- Dil seçici -->
<div class="d-flex align-items-center gap-2 mb-4">
    <span class="text-muted small fw-semibold me-1">Dil:</span>
    <% ['az','ru','en','tr'].forEach(function(lng) { %>
    <button type="button" class="btn btn-sm lang-tab-btn <%= lng === currentLang ? 'btn-primary' : 'btn-outline-secondary' %>"
        data-lang="<%= lng %>" style="min-width:48px;">
        <%= lng.toUpperCase() %>
    </button>
    <% }); %>
</div>

<ul class="nav nav-tabs mb-4" id="contentTabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab-home">Ana Səhifə</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-search">Axtarış & Kataloq</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-about">Haqqımızda</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-howitworks">Necə işləyir</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-auth">Auth Mətnləri</a>
    </li>
</ul>

<form method="POST" action="/dashboard/sehife-mezmunu" id="contentForm">
    <input type="hidden" name="lang" id="currentLang" value="az">

    <div class="tab-content">

        <!-- Ana Səhifə -->
        <div class="tab-pane fade show active" id="tab-home">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-house me-2 text-primary"></i>Ana Səhifə Hero</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlıq</label>
                        <input type="text" name="home_hero_title" class="form-control lang-field" data-key="home_hero_title"
                            value="<%= settings.home_hero_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alt başlıq</label>
                        <input type="text" name="home_hero_subtitle" class="form-control lang-field" data-key="home_hero_subtitle"
                            value="<%= settings.home_hero_subtitle %>">
                    </div>
                </div>
            </div>
        </div>

        <!-- Axtarış & Kataloq -->
        <div class="tab-pane fade" id="tab-search">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-search me-2 text-primary"></i>Axtarış paneli başlıqları</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Eyebrow mətni (kiçik)</label>
                        <input type="text" name="search_eyebrow" class="form-control lang-field" data-key="search_eyebrow" value="<%= settings.search_eyebrow %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Əsas başlıq</label>
                        <input type="text" name="search_title" class="form-control lang-field" data-key="search_title" value="<%= settings.search_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Marşrut bölməsi başlığı</label>
                        <input type="text" name="search_route_label" class="form-control lang-field" data-key="search_route_label" value="<%= settings.search_route_label %>">
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-funnel me-2 text-warning"></i>Filter sahələri</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Yükləmə şəhəri</label>
                            <input type="text" name="search_pickup_city" class="form-control lang-field" data-key="search_pickup_city" value="<%= settings.search_pickup_city %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Çatdırılma şəhəri</label>
                            <input type="text" name="search_delivery_city" class="form-control lang-field" data-key="search_delivery_city" value="<%= settings.search_delivery_city %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Yük növü</label>
                            <input type="text" name="search_cargo_type" class="form-control lang-field" data-key="search_cargo_type" value="<%= settings.search_cargo_type %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Nəqliyyat növü</label>
                            <input type="text" name="search_vehicle_type" class="form-control lang-field" data-key="search_vehicle_type" value="<%= settings.search_vehicle_type %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Açar söz sahəsi</label>
                            <input type="text" name="search_keyword" class="form-control lang-field" data-key="search_keyword" value="<%= settings.search_keyword %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Açar söz placeholder</label>
                            <input type="text" name="search_keyword_placeholder" class="form-control lang-field" data-key="search_keyword_placeholder" value="<%= settings.search_keyword_placeholder %>">
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-toggles me-2 text-success"></i>Düymə və mesajlar</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Axtar düyməsi</label>
                            <input type="text" name="search_btn" class="form-control lang-field" data-key="search_btn" value="<%= settings.search_btn %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Axtarılır... mətni</label>
                            <input type="text" name="search_btn_loading" class="form-control lang-field" data-key="search_btn_loading" value="<%= settings.search_btn_loading %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ətraflı filter düyməsi</label>
                            <input type="text" name="search_advanced_btn" class="form-control lang-field" data-key="search_advanced_btn" value="<%= settings.search_advanced_btn %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ətraflı filter hint mətni</label>
                            <input type="text" name="search_advanced_hint" class="form-control lang-field" data-key="search_advanced_hint" value="<%= settings.search_advanced_hint %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Son elanlar başlığı</label>
                            <input type="text" name="listings_title" class="form-control lang-field" data-key="listings_title" value="<%= settings.listings_title %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Kateqoriyalar başlığı</label>
                            <input type="text" name="categories_title" class="form-control lang-field" data-key="categories_title" value="<%= settings.categories_title %>">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Haqqımızda -->
        <div class="tab-pane fade" id="tab-about">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-info-circle me-2 text-success"></i>Hero bölmə</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlıq</label>
                        <input type="text" name="about_hero_title" class="form-control lang-field" data-key="about_hero_title"
                            value="<%= settings.about_hero_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Təsvir</label>
                        <input type="text" name="about_hero_description" class="form-control lang-field" data-key="about_hero_description"
                            value="<%= settings.about_hero_description %>">
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-paragraph me-2 text-warning"></i>Paraqraflar <small class="text-muted fw-normal">(hər sətir ayrı paraqraf)</small></h6>
                    <textarea name="about_paragraphs_raw" class="form-control lang-field" data-key="about_paragraphs_raw"
                        rows="6"><%= settings.about_paragraphs_raw %></textarea>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-check2-all me-2 text-danger"></i>Əsas üstünlüklər <small class="text-muted fw-normal">(hər sətir ayrı maddə)</small></h6>
                    <textarea name="about_advantages_raw" class="form-control lang-field" data-key="about_advantages_raw"
                        rows="8"><%= settings.about_advantages_raw %></textarea>
                </div>
            </div>
        </div>

        <!-- Necə işləyir -->
        <div class="tab-pane fade" id="tab-howitworks">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-signpost me-2 text-primary"></i>Hero bölmə</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlıq</label>
                        <input type="text" name="howitworks_title" class="form-control lang-field" data-key="howitworks_title"
                            value="<%= settings.howitworks_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Təsvir</label>
                        <textarea name="howitworks_description" class="form-control lang-field" data-key="howitworks_description"
                            rows="2"><%= settings.howitworks_description %></textarea>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-grid me-2 text-success"></i>Addımlar</h6>
                    <% for (let i = 0; i < 4; i++) { %>
                    <div class="border rounded-3 p-3 mb-3">
                        <div class="fw-semibold text-slate-600 mb-2">Addım <%= i + 1 %></div>
                        <div class="mb-2">
                            <label class="form-label small">İkon</label>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center justify-content-center rounded-3 bg-warning bg-opacity-10 text-warning flex-shrink-0"
                                    style="width:40px;height:40px;" id="icon-preview-<%= i %>"></div>
                                <select name="step_icon_<%= i %>" class="form-select form-select-sm icon-select" data-preview="icon-preview-<%= i %>">
                                    <% ['UploadCloud','ShieldCheck','ClipboardList','PhoneCall'].forEach(function(icon) { %>
                                        <option value="<%= icon %>" <%= settings.steps[i] && settings.steps[i].icon === icon ? 'selected' : '' %>><%= icon %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Başlıq</label>
                            <input type="text" name="step_title_<%= i %>" class="form-control form-control-sm lang-field"
                                data-key="step_title_<%= i %>"
                                value="<%= settings.steps[i] ? settings.steps[i].title : '' %>">
                        </div>
                        <div>
                            <label class="form-label small">Mətn</label>
                            <textarea name="step_text_<%= i %>" class="form-control form-control-sm lang-field"
                                data-key="step_text_<%= i %>"
                                rows="2"><%= settings.steps[i] ? settings.steps[i].text : '' %></textarea>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

    <!-- Auth Mətnləri -->
        <div class="tab-pane fade" id="tab-auth">

            <div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color:#1e293b;"><i class="bi bi-box-arrow-in-right me-2 text-primary"></i>Giriş səhifəsi</h6>
                    <div class="row g-3">
                        <div class="col-12"><label class="form-label fw-semibold">Eyebrow mətni</label><input type="text" name="login_eyebrow" class="form-control lang-field" data-key="login_eyebrow" value="<%= settings.login_eyebrow %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Başlıq</label><input type="text" name="login_title" class="form-control lang-field" data-key="login_title" value="<%= settings.login_title %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Alt başlıq</label><input type="text" name="login_subtitle" class="form-control lang-field" data-key="login_subtitle" value="<%= settings.login_subtitle %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Tab: Yük sahibi</label><input type="text" name="login_tab_owner" class="form-control lang-field" data-key="login_tab_owner" value="<%= settings.login_tab_owner %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Tab: Yük daşıyan</label><input type="text" name="login_tab_carrier" class="form-control lang-field" data-key="login_tab_carrier" value="<%= settings.login_tab_carrier %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Metod: Telefon</label><input type="text" name="login_method_phone" class="form-control lang-field" data-key="login_method_phone" value="<%= settings.login_method_phone %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Metod: E-poçt</label><input type="text" name="login_method_email" class="form-control lang-field" data-key="login_method_email" value="<%= settings.login_method_email %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Şifrə sahəsi</label><input type="text" name="login_field_password" class="form-control lang-field" data-key="login_field_password" value="<%= settings.login_field_password %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Şifrə placeholder</label><input type="text" name="login_field_password_placeholder" class="form-control lang-field" data-key="login_field_password_placeholder" value="<%= settings.login_field_password_placeholder %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Şifrəni unutmusan?</label><input type="text" name="login_forgot_password" class="form-control lang-field" data-key="login_forgot_password" value="<%= settings.login_forgot_password %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Giriş düyməsi</label><input type="text" name="login_btn" class="form-control lang-field" data-key="login_btn" value="<%= settings.login_btn %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Giriş düyməsi (yüklənir)</label><input type="text" name="login_btn_loading" class="form-control lang-field" data-key="login_btn_loading" value="<%= settings.login_btn_loading %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Giriş düyməsi (sahibi)</label><input type="text" name="login_btn_owner" class="form-control lang-field" data-key="login_btn_owner" value="<%= settings.login_btn_owner %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Giriş düyməsi (daşıyan)</label><input type="text" name="login_btn_carrier" class="form-control lang-field" data-key="login_btn_carrier" value="<%= settings.login_btn_carrier %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Hesab yoxdur?</label><input type="text" name="login_no_account" class="form-control lang-field" data-key="login_no_account" value="<%= settings.login_no_account %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Qeydiyyat linki (sahibi)</label><input type="text" name="login_register_owner" class="form-control lang-field" data-key="login_register_owner" value="<%= settings.login_register_owner %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Qeydiyyat linki (daşıyan)</label><input type="text" name="login_register_carrier" class="form-control lang-field" data-key="login_register_carrier" value="<%= settings.login_register_carrier %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Sidebar başlığı</label><input type="text" name="login_sidebar_title" class="form-control lang-field" data-key="login_sidebar_title" value="<%= settings.login_sidebar_title %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Sidebar: sahibi başlığı</label><input type="text" name="login_sidebar_owner_title" class="form-control lang-field" data-key="login_sidebar_owner_title" value="<%= settings.login_sidebar_owner_title %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Sidebar: daşıyan başlığı</label><input type="text" name="login_sidebar_carrier_title" class="form-control lang-field" data-key="login_sidebar_carrier_title" value="<%= settings.login_sidebar_carrier_title %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Sidebar: sahibi təsviri</label><input type="text" name="login_sidebar_owner_desc" class="form-control lang-field" data-key="login_sidebar_owner_desc" value="<%= settings.login_sidebar_owner_desc %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Sidebar: daşıyan təsviri</label><input type="text" name="login_sidebar_carrier_desc" class="form-control lang-field" data-key="login_sidebar_carrier_desc" value="<%= settings.login_sidebar_carrier_desc %>"></div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color:#1e293b;"><i class="bi bi-person-plus me-2 text-success"></i>Qeydiyyat səhifəsi</h6>
                    <div class="row g-3">
                        <div class="col-12"><label class="form-label fw-semibold">Başlıq</label><input type="text" name="register_title" class="form-control lang-field" data-key="register_title" value="<%= settings.register_title %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Eyebrow (sahibi)</label><input type="text" name="register_eyebrow_owner" class="form-control lang-field" data-key="register_eyebrow_owner" value="<%= settings.register_eyebrow_owner %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Eyebrow (daşıyan)</label><input type="text" name="register_eyebrow_carrier" class="form-control lang-field" data-key="register_eyebrow_carrier" value="<%= settings.register_eyebrow_carrier %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Alt başlıq (sahibi)</label><input type="text" name="register_subtitle_owner" class="form-control lang-field" data-key="register_subtitle_owner" value="<%= settings.register_subtitle_owner %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Alt başlıq (daşıyan)</label><input type="text" name="register_subtitle_carrier" class="form-control lang-field" data-key="register_subtitle_carrier" value="<%= settings.register_subtitle_carrier %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Ad sahəsi</label><input type="text" name="register_field_firstname" class="form-control lang-field" data-key="register_field_firstname" value="<%= settings.register_field_firstname %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Soyad sahəsi</label><input type="text" name="register_field_lastname" class="form-control lang-field" data-key="register_field_lastname" value="<%= settings.register_field_lastname %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Telefon sahəsi</label><input type="text" name="register_field_phone" class="form-control lang-field" data-key="register_field_phone" value="<%= settings.register_field_phone %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Email sahəsi</label><input type="text" name="register_field_email" class="form-control lang-field" data-key="register_field_email" value="<%= settings.register_field_email %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Şifrə sahəsi</label><input type="text" name="register_field_password" class="form-control lang-field" data-key="register_field_password" value="<%= settings.register_field_password %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Şirkət sahəsi</label><input type="text" name="register_field_company" class="form-control lang-field" data-key="register_field_company" value="<%= settings.register_field_company %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">VÖEN sahəsi</label><input type="text" name="register_field_voen" class="form-control lang-field" data-key="register_field_voen" value="<%= settings.register_field_voen %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Hesab yarat düyməsi</label><input type="text" name="register_btn" class="form-control lang-field" data-key="register_btn" value="<%= settings.register_btn %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Hesab yarat (yüklənir)</label><input type="text" name="register_btn_loading" class="form-control lang-field" data-key="register_btn_loading" value="<%= settings.register_btn_loading %>"></div>
                        <div class="col-12"><label class="form-label fw-semibold">Şərtlər mətni (əvvəl)</label><input type="text" name="register_terms_prefix" class="form-control lang-field" data-key="register_terms_prefix" value="<%= settings.register_terms_prefix %>"></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">İstifadə şərtləri linki</label><input type="text" name="register_terms_link" class="form-control lang-field" data-key="register_terms_link" value="<%= settings.register_terms_link %>"></div>
