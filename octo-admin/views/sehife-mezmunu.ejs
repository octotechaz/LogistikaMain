<script>
const ICON_SVGS = {
  UploadCloud: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>`,
  ShieldCheck: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  ClipboardList: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><line x1="12" y1="11" x2="16" y2="11"/><line x1="12" y1="16" x2="16" y2="16"/><line x1="8" y1="11" x2="8.01" y2="11"/><line x1="8" y1="16" x2="8.01" y2="16"/></svg>`,
  PhoneCall: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/><path d="M14.05 2a9 9 0 0 1 8 7.94"/><path d="M14.05 6A5 5 0 0 1 18 10"/></svg>`,
};

// İkon preview
function updateIconPreview(select) {
  const id = select.getAttribute('data-preview');
  const el = document.getElementById(id);
  if (el) el.innerHTML = ICON_SVGS[select.value] || '';
}
document.querySelectorAll('.icon-select').forEach(s => {
  updateIconPreview(s);
  s.addEventListener('change', () => updateIconPreview(s));
});

// Dil cache - sahə dəyərlərini saxla
const langCache = { az: {}, ru: {}, en: {}, tr: {} };
let currentLang = '<%= currentLang %>';

function collectCurrentFields() {
  document.querySelectorAll('.lang-field').forEach(el => {
    langCache[currentLang][el.getAttribute('data-key')] = el.value;
  });
}

function applyFieldsFromData(data, lang) {
  document.querySelectorAll('.lang-field').forEach(el => {
    const key = el.getAttribute('data-key');
    // Addım sahələri: step_title_0, step_text_0 -> howitworks_steps[i]
    const stepTitleMatch = key.match(/^step_title_(\d+)$/);
    const stepTextMatch = key.match(/^step_text_(\d+)$/);
    const stepIconMatch = key.match(/^step_icon_(\d+)$/);
    let val = '';
    if (stepTitleMatch && Array.isArray(data.howitworks_steps)) {
      val = (data.howitworks_steps[+stepTitleMatch[1]] || {}).title || '';
    } else if (stepTextMatch && Array.isArray(data.howitworks_steps)) {
      val = (data.howitworks_steps[+stepTextMatch[1]] || {}).text || '';
    } else if (stepIconMatch) {
      // select üçün ayrıca idarə et
      const iconVal = Array.isArray(data.howitworks_steps)
        ? (data.howitworks_steps[+stepIconMatch[1]] || {}).icon || 'UploadCloud'
        : 'UploadCloud';
      const select = document.querySelector(`[name="step_icon_${stepIconMatch[1]}"]`);
      if (select) { select.value = iconVal; updateIconPreview(select); }
      langCache[lang][key] = iconVal;
      return;
    } else {
      const rawKey = key.endsWith('_raw') ? key.slice(0, -4) : key;
      val = data[rawKey] ?? data[key] ?? '';
      if (Array.isArray(val)) val = val.join('\n');
    }
    el.value = val;
    langCache[lang][key] = val;
  });
}

function applyLang(lang) {
  if (Object.keys(langCache[lang]).length === 0) {
    fetch('/dashboard/api/page-content?locale=' + lang)
      .then(r => r.ok ? r.json() : null)
      .then(data => { if (data) applyFieldsFromData(data, lang); });
  } else {
    document.querySelectorAll('.lang-field').forEach(el => {
      const key = el.getAttribute('data-key');
      if (langCache[lang][key] !== undefined) el.value = langCache[lang][key];
    });
    // Icon select-lər üçün
    [0,1,2,3].forEach(i => {
      const iconKey = `step_icon_${i}`;
      const select = document.querySelector(`[name="${iconKey}"]`);
      if (select && langCache[lang][iconKey]) {
        select.value = langCache[lang][iconKey];
        updateIconPreview(select);
      }
    });
  }
}

document.querySelectorAll('.lang-tab-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    collectCurrentFields();
    currentLang = this.getAttribute('data-lang');
    document.getElementById('currentLang').value = currentLang;
    document.querySelectorAll('.lang-tab-btn').forEach(b => {
      b.classList.remove('btn-primary');
      b.classList.add('btn-outline-secondary');
    });
    this.classList.add('btn-primary');
    this.classList.remove('btn-outline-secondary');
    const url = new URL(window.location.href);
    url.searchParams.set('lang', currentLang);
    history.replaceState(null, '', url.toString());
    applyLang(currentLang);
  });
});

// Cari dil sahələrini cache-ə yüklə
document.querySelectorAll('.lang-field').forEach(el => {
  langCache[currentLang][el.getAttribute('data-key')] = el.value;
});
// Icon select-ləri cari dil cache-inə əlavə et
[0,1,2,3].forEach(i => {
  const select = document.querySelector(`[name="step_icon_${i}"]`);
  if (select) langCache[currentLang][`step_icon_${i}`] = select.value;
});
</script>

