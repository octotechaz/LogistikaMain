<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold" style="color: #1e293b;">Səhifə Məzmunu</h4>
</div>

<% if (saved) { %>
    <div class="alert alert-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>Dəyişikliklər uğurla saxlandı.
    </div>
<% } %>
<% if (error) { %>
    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>Saxlama zamanı xəta baş verdi.
    </div>
<% } %>

<ul class="nav nav-tabs mb-4" id="contentTabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#tab-home">Ana Səhifə</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-about">Haqqımızda</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-howitworks">Necə işləyir</a>
    </li>
</ul>

<form method="POST" action="/dashboard/sehife-mezmunu">

    <div class="tab-content">

        <!-- Ana Səhifə -->
        <div class="tab-pane fade show active" id="tab-home">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-house me-2 text-primary"></i>Ana Səhifə Hero</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlıq</label>
                        <input type="text" name="home_hero_title" class="form-control" value="<%= settings.home_hero_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alt başlıq</label>
                        <input type="text" name="home_hero_subtitle" class="form-control" value="<%= settings.home_hero_subtitle %>">
                    </div>
                </div>
            </div>
        </div>

        <!-- Haqqımızda -->
        <div class="tab-pane fade" id="tab-about">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-info-circle me-2 text-success"></i>Hero bölmə</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlıq</label>
                        <input type="text" name="about_hero_title" class="form-control" value="<%= settings.about_hero_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Təsvir</label>
                        <input type="text" name="about_hero_description" class="form-control" value="<%= settings.about_hero_description %>">
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-paragraph me-2 text-warning"></i>Paraqraflar (hər sətir ayrı paraqraf)</h6>
                    <textarea name="about_paragraphs_raw" class="form-control" rows="6" placeholder="Hər sətir ayrı paraqraf olacaq..."><%= settings.about_paragraphs_raw %></textarea>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-check2-all me-2 text-danger"></i>Əsas üstünlüklər (hər sətir ayrı maddə)</h6>
                    <textarea name="about_advantages_raw" class="form-control" rows="8" placeholder="Hər sətir ayrı üstünlük olacaq..."><%= settings.about_advantages_raw %></textarea>
                </div>
            </div>
        </div>

        <!-- Necə işləyir -->
        <div class="tab-pane fade" id="tab-howitworks">
            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-signpost me-2 text-primary"></i>Hero bölmə</h6>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Başlıq</label>
                        <input type="text" name="howitworks_title" class="form-control" value="<%= settings.howitworks_title %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Təsvir</label>
                        <textarea name="howitworks_description" class="form-control" rows="2"><%= settings.howitworks_description %></textarea>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-grid me-2 text-success"></i>Addımlar</h6>
                    <p class="text-muted small mb-3">Hər addım üçün başlıq və mətn daxil edin. İkon seçimləri: UploadCloud, ShieldCheck, ClipboardList, PhoneCall</p>
                    <% for (let i = 0; i < 4; i++) { %>
                    <div class="border rounded-3 p-3 mb-3">
                        <div class="fw-semibold text-slate-600 mb-2">Addım <%= i + 1 %></div>
                        <div class="mb-2">
                            <label class="form-label small">İkon</label>
                            <select name="step_icon_<%= i %>" class="form-select form-select-sm">
                                <% const icons = ['UploadCloud','ShieldCheck','ClipboardList','PhoneCall']; %>
                                <% icons.forEach(icon => { %>
                                    <option value="<%= icon %>" <%= settings.steps[i] && settings.steps[i].icon === icon ? 'selected' : '' %>><%= icon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Başlıq</label>
                            <input type="text" name="step_title_<%= i %>" class="form-control form-control-sm" value="<%= settings.steps[i] ? settings.steps[i].title : '' %>">
                        </div>
                        <div>
                            <label class="form-label small">Mətn</label>
                            <textarea name="step_text_<%= i %>" class="form-control form-control-sm" rows="2"><%= settings.steps[i] ? settings.steps[i].text : '' %></textarea>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
            <i class="bi bi-save me-2"></i>Saxla
        </button>
    </div>

</form>

<%- include('partials/footer') %>