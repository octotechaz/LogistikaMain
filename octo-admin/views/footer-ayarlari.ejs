<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold" style="color: #1e293b;">Footer Ayarları</h4>
</div>

<% if (saved) { %>
    <div class="alert alert-success mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        Dəyişikliklər uğurla saxlandı.
    </div>
<% } %>
<% if (error) { %>
    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Saxlama zamanı xəta baş verdi. Yenidən cəhd edin.
    </div>
<% } %>

<form method="POST" action="/dashboard/footer-ayarlari">
    <div class="row g-4">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-telephone me-2 text-primary"></i>Əlaqə məlumatları</h6>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telefon nömrəsi</label>
                        <input type="text" name="phone" class="form-control" value="<%= settings.phone %>" placeholder="+994 50 123 45 67">
                        <div class="form-text">Footerdə göstəriləcək nömrə (tel: linki üçün)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">WhatsApp nömrəsi</label>
                        <input type="text" name="whatsapp" class="form-control" value="<%= settings.whatsapp %>" placeholder="994501234567">
                        <div class="form-text">Rəqəmlər yalnız, ölkə kodu ilə (wa.me/... üçün)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">E-poçt</label>
                        <input type="email" name="email" class="form-control" value="<%= settings.email %>" placeholder="info@tranzit.az">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telegram istifadəçi adı</label>
                        <div class="input-group">
                            <span class="input-group-text">@</span>
                            <input type="text" name="telegram" class="form-control" value="<%= settings.telegram %>" placeholder="tranzitaz">
                        </div>
                        <div class="form-text">Yalnız istifadəçi adı, @ olmadan (t.me/... üçün)</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">İş saatları</label>
                        <input type="text" name="workHours" class="form-control" value="<%= settings.workHours %>" placeholder="Hər gün 09:00-20:00">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-file-text me-2 text-success"></i>Mətn məlumatları</h6>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Copyright mətni</label>
                        <input type="text" name="copyright" class="form-control" value="<%= settings.copyright %>" placeholder="© 2026 Tranzit.AZ. Bütün hüquqlar qorunur.">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Alt mətn (tagline)</label>
                        <input type="text" name="tagline" class="form-control" value="<%= settings.tagline %>" placeholder="Yük elanları və daşıma əlaqələri üçün public platforma.">
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4" style="border-radius: 12px; background: #f8fafc;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3" style="color: #1e293b;"><i class="bi bi-eye me-2 text-secondary"></i>Önizləmə</h6>
                    <div class="p-3 bg-white rounded border" style="font-size: 0.85rem; color: #64748b;">
                        <div class="mb-2"><i class="bi bi-telephone me-1"></i> <strong id="prev-phone"><%= settings.phone %></strong></div>
                        <div class="mb-2"><i class="bi bi-clock me-1"></i> <span id="prev-hours"><%= settings.workHours %></span></div>
                        <div class="mb-2"><i class="bi bi-whatsapp me-1"></i> wa.me/<span id="prev-wa"><%= settings.whatsapp %></span></div>
                        <div class="mb-2"><i class="bi bi-envelope me-1"></i> <span id="prev-email"><%= settings.email %></span></div>
                        <div class="mb-2"><i class="bi bi-telegram me-1"></i> t.me/<span id="prev-tg"><%= settings.telegram %></span></div>
                        <hr class="my-2">
                        <div class="mb-1"><span id="prev-copyright"><%= settings.copyright %></span></div>
                        <div><span id="prev-tagline"><%= settings.tagline %></span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius: 8px;">
                <i class="bi bi-save me-2"></i>Saxla
            </button>
        </div>
    </div>
</form>

<script>
    const fields = [
        ['phone', 'prev-phone'],
        ['whatsapp', 'prev-wa'],
        ['email', 'prev-email'],
        ['telegram', 'prev-tg'],
        ['workHours', 'prev-hours'],
        ['copyright', 'prev-copyright'],
        ['tagline', 'prev-tagline'],
    ];
    fields.forEach(([name, id]) => {
        const input = document.querySelector(`[name="${name}"]`);
        const preview = document.getElementById(id);
        if (input && preview) {
            input.addEventListener('input', () => { preview.textContent = input.value; });
        }
    });
</script>

<%- include('partials/footer') %>