<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kateqoriyalar - Octo Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .modal { display: none; }
        .modal.active { display: flex; }
    </style>
</head>
<body class="bg-gray-50 flex h-screen overflow-hidden text-gray-800 font-sans">
    
    <%- include('partials/header') %>

    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
            <div class="max-w-6xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <h1 class="text-2xl font-bold text-gray-800">Kateqoriyalar</h1>
                    <button type="button" id="openNewCategoryBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
                        <i class="fas fa-plus"></i> Yeni Kateqoriya
                    </button>
                </div>

                <% if (flash) { %>
                    <div id="flashBanner" class="mb-4 rounded-lg border px-4 py-3 text-sm font-medium <%= flash.type === 'error' ? 'border-red-200 bg-red-50 text-red-700' : 'border-green-200 bg-green-50 text-green-700' %>">
                        <%= flash.message %>
                    </div>
                <% } %>

                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200 text-gray-500 text-sm">
                                    <th class="p-4 font-semibold">İkon & Ad</th>
                                    <th class="p-4 font-semibold">Sıra</th>
                                    <th class="p-4 font-semibold">Status</th>
                                    <th class="p-4 font-semibold text-right">Əməliyyatlar</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <% if (categories.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="p-8 text-center text-gray-500">
                                            Heç bir kateqoriya tapılmadı.
                                        </td>
                                    </tr>
                                <% } %>
                                
                                <% categories.forEach(function(cat) { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded bg-gray-100 flex items-center justify-center <%= cat.icon_tone || 'text-slate-500' %>">
                                                    <i class="fas fa-<%= cat.icon_key || 'box' %> text-xl"></i>
                                                </div>
                                                <div class="font-medium text-gray-900"><%= cat.label %></div>
                                            </div>
                                        </td>
                                        <td class="p-4 text-gray-600"><%= cat.sort_order %></td>
                                        <td class="p-4">
                                            <% if (cat.is_active === 1 || cat.is_active === true) { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    Aktiv
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                    Deaktiv
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="p-4 text-right">
                                            <button
                                                type="button"
                                                class="edit-category-btn text-indigo-600 hover:text-indigo-900 mx-2"
                                                data-category-id="<%= cat.id %>"
                                                title="Düzəliş et"
                                            >
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form action="/dashboard/kategoriler/delete" method="POST" class="inline-block" onsubmit="return confirm('Bu kateqoriyanı silmək istədiyinizə əminsiniz?');">
                                                <input type="hidden" name="id" value="<%= cat.id %>">
                                                <button type="submit" class="text-red-600 hover:text-red-900 mx-2" title="Sil">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal -->
    <div id="categoryModal" class="modal fixed inset-0 z-50 items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full overflow-hidden" onclick="event.stopPropagation()">
            <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                <h3 id="modalTitle" class="font-semibold text-lg text-gray-800">Yeni Kateqoriya</h3>
                <button type="button" id="closeModalBtn" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <form action="/dashboard/kategoriler" method="POST" class="p-6">
                <input type="hidden" id="cat_id" name="id" value="">
                
                <div class="space-y-4">
                    <div>
                        <label for="cat_label" class="block text-sm font-medium text-gray-700 mb-1">Kateqoriya Adı *</label>
                        <input type="text" id="cat_label" name="label" required autocomplete="off" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="cat_icon" class="block text-sm font-medium text-gray-700 mb-1">İkon Seçin</label>
                            <div class="relative">
                                <div id="iconPreviewContainer" class="absolute left-3 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center text-slate-500">
                                    <i id="iconPreview" class="fas fa-box text-lg"></i>
                                </div>
                                <select id="cat_icon" name="icon_key" class="w-full pl-12 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all appearance-none bg-white">
                                    <option value="layer-group">Hamısı (Layer Group)</option>
                                    <option value="grid-2">Grid</option>
                                    <option value="box">Qutu (Box)</option>
                                    <option value="boxes">Qutular (Boxes)</option>
                                    <option value="truck">Yük maşını (Truck)</option>
                                    <option value="truck-fast">Sürətli Yük (Fast Truck)</option>
                                    <option value="truck-moving">Daşınan Yük (Moving Truck)</option>
                                    <option value="pallet">Palet (Pallet)</option>
                                    <option value="dolly">Araba (Dolly)</option>
                                    <option value="warehouse">Anbar (Warehouse)</option>
                                    <option value="cubes">Kublar (Cubes)</option>
                                    <option value="ship">Gəmi (Ship)</option>
                                    <option value="plane">Təyyarə (Plane)</option>
                                    <option value="weight-hanging">Ağırlıq (Weight)</option>
                                    <option value="temperature-arrow-down">Soyuducu (Cold)</option>
                                    <option value="snowflake">Qar dənəsi (Snowflake)</option>
                                    <option value="flask">Maye/Kimyəvi (Liquid)</option>
                                    <option value="droplet">Maye damlası (Droplet)</option>
                                    <option value="fire">Təhlükəli Yük (Hazardous)</option>
                                    <option value="triangle-exclamation">Xəbərdarlıq (Warning)</option>
                                    <option value="car">Avtomobil (Car)</option>
                                    <option value="couch">Mebel (Furniture)</option>
                                    <option value="building">İnşaat (Construction)</option>
                                    <option value="hammer">Tikinti (Hammer)</option>
                                    <option value="apple-whole">Qida (Apple)</option>
                                    <option value="utensils">Yemək (Utensils)</option>
                                    <option value="wheat-awn">Taxıl (Wheat)</option>
                                    <option value="tractor">Traktor (Agriculture)</option>
                                    <option value="ellipsis">Digər (Ellipsis)</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                                    <i class="fas fa-chevron-down text-sm"></i>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label for="cat_tone" class="block text-sm font-medium text-gray-700 mb-1">İkon Rəngi</label>
                            <select id="cat_tone" name="icon_tone" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                                <option value="text-slate-500">Boz (Slate)</option>
                                <option value="text-blue-500">Mavi (Blue)</option>
                                <option value="text-green-500">Yaşıl (Green)</option>
                                <option value="text-orange-500">Narıncı (Orange)</option>
                                <option value="text-purple-500">Bənövşəyi (Purple)</option>
                                <option value="text-red-500">Qırmızı (Red)</option>
                                <option value="text-logistics-orange">Logistika narıncı</option>
                                <option value="text-amber-500">Kəhrəba (Amber)</option>
                                <option value="text-cyan-500">Firuzəyi (Cyan)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="cat_sort" class="block text-sm font-medium text-gray-700 mb-1">Sıralama</label>
                            <input type="number" id="cat_sort" name="sort_order" value="0" min="0" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                        </div>
                        <div>
                            <label for="cat_active" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                            <select id="cat_active" name="is_active" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                                <option value="1">Aktiv</option>
                                <option value="0">Deaktiv</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex justify-end gap-3">
                    <button type="button" id="cancelModalBtn" class="px-5 py-2 rounded-lg border border-gray-300 text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                        Ləğv et
                    </button>
                    <button type="submit" id="submitCategoryBtn" class="px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition-colors">
                        Yadda Saxla
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script id="categoriesData" type="application/json"><%- JSON.stringify(categories) %></script>
    <script>
        const categories = JSON.parse(document.getElementById('categoriesData').textContent || '[]');
        const modal = document.getElementById('categoryModal');
        const iconSelect = document.getElementById('cat_icon');
        const toneSelect = document.getElementById('cat_tone');
        const iconPreview = document.getElementById('iconPreview');
        const iconPreviewContainer = document.getElementById('iconPreviewContainer');
        const labelInput = document.getElementById('cat_label');
        const categoryMap = new Map(categories.map(function(cat) { return [cat.id, cat]; }));

        function ensureIconOption(iconKey) {
            const key = iconKey || 'box';
            const exists = Array.from(iconSelect.options).some(function(opt) { return opt.value === key; });
            if (exists) {
                return key;
            }

            const customOption = document.createElement('option');
            customOption.value = key;
            customOption.textContent = key + ' (mövcud)';
            iconSelect.appendChild(customOption);
            return key;
        }

        function ensureToneOption(iconTone) {
            const tone = iconTone || 'text-slate-500';
            const exists = Array.from(toneSelect.options).some(function(opt) { return opt.value === tone; });
            if (exists) {
                return tone;
            }

            const customOption = document.createElement('option');
            customOption.value = tone;
            customOption.textContent = tone + ' (mövcud)';
            toneSelect.appendChild(customOption);
            return tone;
        }

        function updatePreview() {
            const icon = iconSelect.value || 'box';
            const tone = toneSelect.value || 'text-slate-500';

            iconPreview.className = 'fas fa-' + icon + ' text-lg';
            iconPreviewContainer.className = 'absolute left-3 top-1/2 -translate-y-1/2 w-6 h-6 flex items-center justify-center ' + tone;
        }

        function openModal() {
            document.getElementById('modalTitle').textContent = 'Yeni Kateqoriya';
            document.getElementById('submitCategoryBtn').textContent = 'Yadda Saxla';
            document.getElementById('cat_id').value = '';
            labelInput.value = '';
            iconSelect.value = ensureIconOption('box');
            toneSelect.value = ensureToneOption('text-slate-500');
            document.getElementById('cat_sort').value = String(categories.length + 1);
            document.getElementById('cat_active').value = '1';

            updatePreview();
            modal.classList.add('active');
            window.setTimeout(function() { labelInput.focus(); }, 50);
        }

        function editCategory(id) {
            const cat = categoryMap.get(id);
            if (!cat) {
                return;
            }

            document.getElementById('modalTitle').textContent = 'Kateqoriyanı Yenilə';
            document.getElementById('submitCategoryBtn').textContent = 'Dəyişiklikləri Saxla';
            document.getElementById('cat_id').value = cat.id;
            labelInput.value = cat.label || '';
            iconSelect.value = ensureIconOption(cat.icon_key);
            toneSelect.value = ensureToneOption(cat.icon_tone);
            document.getElementById('cat_sort').value = String(cat.sort_order ?? 0);
            document.getElementById('cat_active').value = (cat.is_active === 1 || cat.is_active === true) ? '1' : '0';

            updatePreview();
            modal.classList.add('active');
            window.setTimeout(function() { labelInput.focus(); labelInput.select(); }, 50);
        }

        function closeModal() {
            modal.classList.remove('active');
        }

        iconSelect.addEventListener('change', updatePreview);
        toneSelect.addEventListener('change', updatePreview);
        document.getElementById('openNewCategoryBtn').addEventListener('click', openModal);
        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('cancelModalBtn').addEventListener('click', closeModal);

        document.querySelectorAll('.edit-category-btn').forEach(function(button) {
            button.addEventListener('click', function() {
                editCategory(button.getAttribute('data-category-id'));
            });
        });

        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.classList.contains('active')) {
                closeModal();
            }
        });

        const flashBanner = document.getElementById('flashBanner');
        if (flashBanner) {
            window.setTimeout(function() {
                flashBanner.classList.add('opacity-0', 'transition-opacity', 'duration-500');
                window.setTimeout(function() { flashBanner.remove(); }, 500);
            }, 4000);
        }

        const url = new URL(window.location.href);
        if (url.searchParams.has('saved') || url.searchParams.has('deleted') || url.searchParams.has('error')) {
            url.searchParams.delete('saved');
            url.searchParams.delete('deleted');
            url.searchParams.delete('error');
            window.history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
        }
    </script>
</body>
</html>
