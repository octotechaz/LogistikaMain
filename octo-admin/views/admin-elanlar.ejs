<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold" style="color: #1e293b; font-size: 1.25rem;">Bütün Elanlar (Admin İdarəetmə)</h5>
</div>

<% if(typeof req !== 'undefined' && req.query) { %>
    <% if(req.query.updated) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 10px;">
            <i class="bi bi-check-circle-fill me-2"></i> Elan statusu uğurla yeniləndi!
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if(req.query.deleted) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 10px;">
            <i class="bi bi-check-circle-fill me-2"></i> Elan uğurla silindi!
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
<% } %>

<div class="card shadow-sm border-0" style="border-radius: 10px; overflow: hidden;">
    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="myTable" class="table table-hover w-100">
                <thead>
                    <tr>
                        <th class="border-0">ID</th>
                        <th class="border-0">İstifadəçi</th>
                        <th class="border-0">Başlıq</th>
                        <th class="border-0">Marşrut</th>
                        <th class="border-0">Tarix</th>
                        <th class="border-0">Status</th>
                        <th class="border-0 text-end">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(cargos && cargos.length > 0) { %>
                        <% cargos.forEach(cargo => { %>
                            <tr id="elan-<%= cargo.id %>" data-elan-id="<%= cargo.id %>">
                                <td><span class="text-muted fw-semibold">#<%= cargo.id %></span></td>
                                <td>
                                    <div class="text-dark fw-medium"><%= cargo.user_name || 'Naməlum' %></div>
                                    <div class="text-muted small"><%= cargo.user_email %></div>
                                </td>
                                <td><strong class="text-dark"><%= cargo.title %></strong></td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <small class="d-flex align-items-center text-muted">
                                            <i class="bi bi-circle-fill text-primary me-2" style="font-size: 8px;"></i> <%= cargo.loading_city %>
                                        </small>
                                        <small class="d-flex align-items-center text-muted">
                                            <i class="bi bi-geo-alt-fill text-danger me-2" style="font-size: 10px;"></i> <%= cargo.unloading_city %>
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-calendar3 me-2"></i> 
                                        <small><%= cargo.latest_pickup_date %></small>
                                    </div>
                                </td>
                                <td>
                                    <% if(cargo.status === 'PENDING') { %>
                                        <span class="badge" style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 3px 8px; border-radius: 5px;">Gözləyir</span>
                                    <% } else if(cargo.status === 'APPROVED') { %>
                                        <span class="badge" style="background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 3px 8px; border-radius: 5px;">Təsdiqlənib</span>
                                    <% } else if(cargo.status === 'REJECTED') { %>
                                        <span class="badge" style="background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; padding: 3px 8px; border-radius: 5px;">İmtina edilib</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary rounded-pill px-3"><%= cargo.status %></span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end admin-row-actions align-items-center flex-nowrap">
                                        <form action="/dashboard/elan/status/<%= cargo.id %>" method="POST" class="d-inline-flex gap-1 align-items-center mb-0">
                                            <select name="status" class="form-select form-select-sm" style="width: auto; max-width: 7.5rem;">
                                                <option value="PENDING" <%= cargo.status === 'PENDING' ? 'selected' : '' %>>Gözləyir</option>
                                                <option value="APPROVED" <%= cargo.status === 'APPROVED' ? 'selected' : '' %>>Təsdiqlə</option>
                                                <option value="REJECTED" <%= cargo.status === 'REJECTED' ? 'selected' : '' %>>İmtina et</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-primary">Yenilə</button>
                                        </form>
                                        <form action="/dashboard/elan/admin-sil/<%= cargo.id %>" method="POST" onsubmit="return confirm('Bu elanı silmək istədiyinizə əminsiniz?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    (function () {
        const params = new URLSearchParams(window.location.search);
        const elanId = params.get('elan');
        if (!elanId) return;

        const row = document.getElementById('elan-' + elanId)
            || document.querySelector('[data-elan-id="' + elanId + '"]');
        if (!row) return;

        row.classList.add('table-warning');
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    })();
</script>

<%- include('partials/footer') %>