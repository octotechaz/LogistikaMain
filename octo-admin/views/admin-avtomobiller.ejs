<%- include('partials/header') %>

<%
  const vehicleList = Array.isArray(vehicles) ? vehicles : [];
  const pendingCount = vehicleList.filter(v => v.status === 'PENDING').length;
  const approvedCount = vehicleList.filter(v => v.status === 'APPROVED').length;
  const rejectedCount = vehicleList.filter(v => v.status === 'REJECTED').length;

  function statusLabel(status) {
    if (status === 'PENDING') return 'Gözləyir';
    if (status === 'APPROVED') return 'Təsdiqlənib';
    if (status === 'REJECTED') return 'İmtina edilib';
    return status || '—';
  }

  function statusStyle(status) {
    if (status === 'PENDING') return 'background:#fffbeb;color:#b45309;border:1px solid #fde68a;';
    if (status === 'APPROVED') return 'background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;';
    return 'background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;';
  }
%>

<div class="admin-page-header">
  <div>
    <h5>Avtomobil Onayları</h5>
    <p>Daşıyıcı avtomobillərini təsdiqləyin və ya imtina edin</p>
  </div>
</div>

<% if(typeof req !== 'undefined' && req.query && (req.query.updated || req.query.updated === '1')) { %>
  <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 12px;">
    <i class="bi bi-check-circle-fill me-2"></i> Avtomobil statusu uğurla yeniləndi!
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex flex-wrap gap-2 mb-3">
  <span class="badge rounded-pill text-bg-light border px-3 py-2"><%= vehicleList.length %> ümum</span>
  <span class="badge rounded-pill px-3 py-2" style="background:#fffbeb;color:#b45309;border:1px solid #fde68a;"><%= pendingCount %> gözləyir</span>
  <span class="badge rounded-pill px-3 py-2" style="background:#ecfdf5;color:#047857;border:1px solid #a7f3d0;"><%= approvedCount %> təsdiq</span>
  <span class="badge rounded-pill px-3 py-2" style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;"><%= rejectedCount %> imtina</span>
</div>

<div class="admin-shell">
  <div class="admin-desktop-only p-2">
    <div class="table-responsive">
      <table id="myTable" class="table table-hover w-100 mb-0">
        <thead>
          <tr>
            <th class="border-0">Avtomobil</th>
            <th class="border-0">Daşıyıcı</th>
            <th class="border-0">Əlaqə</th>
            <th class="border-0">Status</th>
            <th class="border-0">Şəkil</th>
            <th class="border-0 text-end">Əməliyyat</th>
          </tr>
        </thead>
        <tbody>
          <% if (vehicleList.length > 0) { %>
            <% vehicleList.forEach(vehicle => { %>
              <tr>
                <td>
                  <div class="fw-semibold text-dark"><%= vehicle.brand %> <%= vehicle.model %></div>
                  <div class="text-muted small"><%= vehicle.plateNumber %> • <%= vehicle.vehicleType %></div>
                </td>
                <td>
                  <div class="text-dark fw-medium"><%= vehicle.carrier?.firstName || '' %> <%= vehicle.carrier?.lastName || '' %></div>
                  <div class="text-muted small"><%= vehicle.carrier?.email || '' %></div>
                </td>
                <td class="text-muted"><%= vehicle.driverPhone %></td>
                <td>
                  <span class="badge" style="<%= statusStyle(vehicle.status) %>"><%= statusLabel(vehicle.status) %></span>
                </td>
                <td>
                  <% if (vehicle.images && vehicle.images[0]) { %>
                    <img src="<%= vehicle.images[0].url %>" alt="Vehicle" style="width: 88px; height: 56px; object-fit: cover; border-radius: 8px;">
                  <% } else { %>
                    <span class="text-muted small">Yoxdur</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <form action="/dashboard/vehicle/status/<%= vehicle.id %>" method="POST" class="admin-actions admin-row-actions mb-0">
                    <select name="status" class="admin-select">
                      <option value="PENDING" <%= vehicle.status === 'PENDING' ? 'selected' : '' %>>Gözləyir</option>
                      <option value="APPROVED" <%= vehicle.status === 'APPROVED' ? 'selected' : '' %>>Təsdiqlə</option>
                      <option value="REJECTED" <%= vehicle.status === 'REJECTED' ? 'selected' : '' %>>İmtina et</option>
                    </select>
                    <button type="submit" class="admin-btn-icon primary" title="Yenilə"><i class="bi bi-check-lg"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-cards admin-mobile-only">
    <% if (vehicleList.length > 0) { %>
      <% vehicleList.forEach(vehicle => { %>
        <article class="admin-card">
          <div class="admin-card-top">
            <div>
              <h3 class="admin-card-title"><%= vehicle.brand %> <%= vehicle.model %></h3>
              <div class="text-muted small"><%= vehicle.plateNumber %> • <%= vehicle.vehicleType %></div>
            </div>
            <span class="badge" style="<%= statusStyle(vehicle.status) %>"><%= statusLabel(vehicle.status) %></span>
          </div>
          <% if (vehicle.images && vehicle.images[0]) { %>
            <img src="<%= vehicle.images[0].url %>" alt="Vehicle" class="w-100 mb-2" style="height:140px;object-fit:cover;border-radius:10px;">
          <% } %>
          <div class="admin-card-meta">
            <div class="admin-card-meta-row">
              <span class="label">Daşıyıcı</span>
              <span class="value"><%= vehicle.carrier?.firstName || '' %> <%= vehicle.carrier?.lastName || '' %></span>
            </div>
            <div class="admin-card-meta-row">
              <span class="label">Əlaqə</span>
              <span class="value"><%= vehicle.driverPhone || '—' %></span>
            </div>
          </div>
          <div class="admin-card-actions">
            <form action="/dashboard/vehicle/status/<%= vehicle.id %>" method="POST" class="d-flex gap-2 align-items-center mb-0 flex-grow-1">
              <select name="status" class="admin-select">
                <option value="PENDING" <%= vehicle.status === 'PENDING' ? 'selected' : '' %>>Gözləyir</option>
                <option value="APPROVED" <%= vehicle.status === 'APPROVED' ? 'selected' : '' %>>Təsdiqlə</option>
                <option value="REJECTED" <%= vehicle.status === 'REJECTED' ? 'selected' : '' %>>İmtina et</option>
              </select>
              <button type="submit" class="admin-btn-icon primary" title="Yenilə"><i class="bi bi-check-lg"></i></button>
            </form>
          </div>
        </article>
      <% }) %>
    <% } else { %>
      <div class="text-center text-muted py-4">Gözləyən avtomobil yoxdur.</div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
