<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold" style="color: #1e293b; font-size: 1.25rem;">Avtomobil Onayları</h5>
</div>

<% if(typeof req !== 'undefined' && req.query && req.query.updated) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 10px;">
        <i class="bi bi-check-circle-fill me-2"></i> Avtomobil statusu uğurla yeniləndi!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="card shadow-sm border-0" style="border-radius: 10px; overflow: hidden;">
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-hover w-100">
                <thead>
                    <tr>
                        <th class="border-0">Avtomobil</th>
                        <th class="border-0">Daşıyıcı</th>
                        <th class="border-0">Əlaqə</th>
                        <th class="border-0">Status</th>
                        <th class="border-0">Şəkil</th>
                        <th class="border-0 text-end">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (vehicles && vehicles.length > 0) { %>
                        <% vehicles.forEach(vehicle => { %>
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark"><%= vehicle.brand %> <%= vehicle.model %></div>
                                    <div class="text-muted small"><%= vehicle.plateNumber %> • <%= vehicle.vehicleType %></div>
                                </td>
                                <td>
                                    <div class="text-dark fw-medium"><%= vehicle.carrier?.firstName || '' %> <%= vehicle.carrier?.lastName || '' %></div>
                                    <div class="text-muted small"><%= vehicle.carrier?.email || '' %></div>
                                </td>
                                <td class="text-muted"><%= vehicle.driverPhone %></td>
                                <td>
                                    <% if(vehicle.status === 'PENDING') { %>
                                        <span class="badge" style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 3px 8px; border-radius: 5px;">Gözləyir</span>
                                    <% } else if(vehicle.status === 'APPROVED') { %>
                                        <span class="badge" style="background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 3px 8px; border-radius: 5px;">Təsdiqlənib</span>
                                    <% } else { %>
                                        <span class="badge" style="background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; padding: 3px 8px; border-radius: 5px;">İmtina edilib</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (vehicle.images && vehicle.images[0]) { %>
                                        <img src="<%= vehicle.images[0].url %>" alt="Vehicle" style="width: 88px; height: 56px; object-fit: cover; border-radius: 8px;">
                                    <% } else { %>
                                        <span class="text-muted small">Yoxdur</span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <form action="/dashboard/vehicle/status/<%= vehicle.id %>" method="POST" class="d-inline-flex gap-1 align-items-center mb-0">
                                        <select name="status" class="form-select form-select-sm" style="width: auto; max-width: 7.5rem;">
                                            <option value="PENDING" <%= vehicle.status === 'PENDING' ? 'selected' : '' %>>Gözləyir</option>
                                            <option value="APPROVED" <%= vehicle.status === 'APPROVED' ? 'selected' : '' %>>Təsdiqlə</option>
                                            <option value="REJECTED" <%= vehicle.status === 'REJECTED' ? 'selected' : '' %>>İmtina et</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary">Yenilə</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Gözləyən avtomobil yoxdur.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
