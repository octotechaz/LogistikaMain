<!-- Tom Select JS -->
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<!-- Intl-tel-input JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Init Tom Select for Cities
        document.querySelectorAll('.tom-select').forEach((el)=>{
            let settings = {
                create: false,
                sortField: {
                    field: "text",
                    direction: "asc"
                }
            };
            new TomSelect(el,settings);
        });

        // Init Flatpickr for Dates
        flatpickr(".flatpickr-date", {
            locale: "az",
            dateFormat: "Y-m-d",
        });

        // Init Flatpickr for Time range
        flatpickr(".flatpickr-time", {
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true
        });

        // Init Intl-Tel-Input
        const phoneInputField = document.querySelector("#phone_input");
        const phoneInput = window.intlTelInput(phoneInputField, {
            initialCountry: "az",
            preferredCountries: ["az", "tr", "ge", "ru"],
            utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
        });
    });

    // Həcm hesablama
    document.querySelectorAll('.calc-dim').forEach(input => {
        input.addEventListener('input', () => {
            const l = parseFloat(document.getElementById('calc_l').value) || 0;
            const w = parseFloat(document.getElementById('calc_w').value) || 0;
            const h = parseFloat(document.getElementById('calc_h').value) || 0;
            if(l > 0 && w > 0 && h > 0) {
                document.querySelector('input[name="volume_display"]').value = (l * w * h).toFixed(2);
            } else {
                document.querySelector('input[name="volume_display"]').value = '';
            }
        });
    });

    // Drag and Drop & Şəkil sayı limiti
    const dropZone = document.getElementById('dropZone');
    const imageInput = document.getElementById('imageInput');
    const previewContainer = document.getElementById('previewContainer');
    const imageCount = document.getElementById('imageCount');
    const clearImagesBtn = document.getElementById('clearImagesBtn');

    let selectedFiles = []; // Seçilmiş faylları tutacaq array

    // Nominatim Address Autocomplete Logic
    function setupAutocomplete(inputId, listId, citySelectId) {
        const input = document.getElementById(inputId);
        const list = document.getElementById(listId);
        const citySelect = document.getElementById(citySelectId);
        let currentFocus = -1;

        input.addEventListener("input", function(e) {
            const val = this.value;
            const city = citySelect.value;
            closeAllLists();
            
            if (!val || val.length < 3) return false;
            if (!city) {
                alert("Zəhmət olmasa əvvəlcə şəhəri seçin!");
                return false;
            }

            currentFocus = -1;
            
            // OpenStreetMap Nominatim API request
            const query = `${val}, ${city}, Azerbaijan`;
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5&addressdetails=1`)
                .then(response => response.json())
                .then(data => {
                    if (data.length > 0) {
                        list.innerHTML = "";
                        list.style.display = "block";
                        
                        data.forEach(item => {
                            const div = document.createElement("div");
                            // Highlight matching text roughly
                            const regex = new RegExp(`(${val})`, "gi");
                            let displayName = item.display_name.split(",").slice(0, 3).join(","); // Keep it short
                            displayName = displayName.replace(regex, "<strong>$1</strong>");
                            
                            div.innerHTML = displayName;
                            div.addEventListener("click", function(e) {
                                // Extract road or suburb if available, otherwise just use the raw value
                                let cleanAddress = item.address.road || item.address.suburb || item.address.neighbourhood || item.display_name.split(",")[0];
                                input.value = cleanAddress;
                                closeAllLists();
                            });
                            list.appendChild(div);
                        });
                    }
                })
                .catch(err => console.error("Autocomplete error:", err));
        });

        input.addEventListener("keydown", function(e) {
            let x = document.getElementById(listId);
            if (x) x = x.getElementsByTagName("div");
            if (e.keyCode == 40) { // Down
                currentFocus++;
                addActive(x);
            } else if (e.keyCode == 38) { // Up
                currentFocus--;
                addActive(x);
            } else if (e.keyCode == 13) { // Enter
                e.preventDefault();
                if (currentFocus > -1) {
                    if (x) x[currentFocus].click();
                }
            }
        });

        function addActive(x) {
            if (!x) return false;
            removeActive(x);
            if (currentFocus >= x.length) currentFocus = 0;
            if (currentFocus < 0) currentFocus = (x.length - 1);
            x[currentFocus].classList.add("autocomplete-active");
        }

        function removeActive(x) {
            for (let i = 0; i < x.length; i++) {
                x[i].classList.remove("autocomplete-active");
            }
        }

        function closeAllLists(elmnt) {
            if (elmnt != input) {
                list.innerHTML = "";
                list.style.display = "none";
            }
        }

        document.addEventListener("click", function (e) {
            closeAllLists(e.target);
        });
    }

    // Initialize Autocomplete for both loading and unloading addresses
    setupAutocomplete("loading_address_input", "loading_address_autocomplete", "loading_city");
    setupAutocomplete("unloading_address_input", "unloading_address_autocomplete", "unloading_city");

    // Klikləyəndə file input açılsın
    dropZone.addEventListener('click', (e) => {
        // Silme butonuna veya resimlere tiklaniyorsa inputu acma
        if (e.target.closest('.remove-btn') || e.target.closest('img') || e.target.id === 'clearImagesBtn') return;
        imageInput.click();
    });

    // Sürükləyib buraxmaq effektləri
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'var(--brand-orange)';
        dropZone.style.backgroundColor = 'rgba(249, 115, 22, 0.05)';
    });

    dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '#dee2e6'; // var(--bs-border-color)
        dropZone.style.backgroundColor = '#f8f9fa'; // bg-light
    });

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '#dee2e6';
        dropZone.style.backgroundColor = '#f8f9fa';
        
        if (e.dataTransfer.files.length > 0) {
            handleFiles(Array.from(e.dataTransfer.files));
        }
    });

    imageInput.addEventListener('change', function(e) {
        if(this.files.length > 0) {
            handleFiles(Array.from(this.files));
        }
    });

    function handleFiles(files) {
        // Sadece resimleri filtrele
        const imageFiles = files.filter(file => file.type.startsWith('image/'));
        
        // Yeni secilenlerle beraber toplam sayiyi kontrol et
        if (selectedFiles.length + imageFiles.length > 10) {
            alert('Maksimum cəmi 10 şəkil əlavə edə bilərsiniz!');
            // Sadece sigabilen kadarini al (opsiyonel, simdilik hepsini reddediyoruz)
            return;
        }

        imageFiles.forEach(file => {
            selectedFiles.push(file);
        });

        updateInputAndPreview();
    }

    function updateInputAndPreview() {
        // Gorselleri goster
        previewContainer.innerHTML = '';
        
        selectedFiles.forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = (e) => {
                const div = document.createElement('div');
                div.className = 'position-relative border rounded overflow-hidden shadow-sm';
                div.style.width = '80px';
                div.style.height = '80px';
                
                div.innerHTML = `
                    <img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: cover;">
                    <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 p-0 remove-btn" 
                            style="width: 20px; height: 20px; border-radius: 0 0 0 4px; line-height: 1;"
                            onclick="removeFile(${index})">
                        &times;
                    </button>
                    ${index === 0 ? '<span class="badge bg-primary position-absolute bottom-0 start-0 w-100 rounded-0" style="font-size: 0.6rem;">Cover</span>' : ''}
                `;
                previewContainer.appendChild(div);
            };
            reader.readAsDataURL(file);
        });

        // Sayaci guncelle
        imageCount.textContent = selectedFiles.length + '/10 şəkil';
        
        // Silme butonunu goster/gizle
        if (selectedFiles.length > 0) {
            clearImagesBtn.classList.remove('d-none');
        } else {
            clearImagesBtn.classList.add('d-none');
        }

        // Seçilen dosyaları input'a (DataTransfer yardımıyla) aktar ki forma submit edildiğinde gitsin
        const dt = new DataTransfer();
        selectedFiles.forEach(file => dt.items.add(file));
        imageInput.files = dt.files;
    }

    // Global scope-a removeFile fonksiyonunu ekleyelim ki onClick çalisabilsin
    window.removeFile = function(index) {
        selectedFiles.splice(index, 1);
        updateInputAndPreview();
    };

    clearImagesBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedFiles = [];
        updateInputAndPreview();
    });
</script>

