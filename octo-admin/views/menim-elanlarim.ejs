<%- include('partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold" style="color: #1e293b;">Mənim elanlarım</h4>
    <a href="/dashboard/yeni-elan" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 500;">
        <i class="bi bi-plus-lg me-1"></i> Yeni Elan
    </a>
</div>

<% if(typeof req !== 'undefined' && req.query && req.query.success) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 10px;">
        <i class="bi bi-check-circle-fill me-2"></i> Elan uğurla əlavə edildi və <strong>PENDING</strong> statusundadır!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="myTable" class="table table-hover w-100">
                <thead>
                    <tr>
                        <th class="border-0">ID</th>
                        <th class="border-0">Başlıq</th>
                        <th class="border-0">Növ</th>
                        <th class="border-0">Çəki (kq)</th>
                        <th class="border-0">Həcm (m³)</th>
                        <th class="border-0">Marşrut</th>
                        <th class="border-0">Son tarix</th>
                        <th class="border-0">Status</th>
                        <th class="border-0 text-end">Yerləşdirilmə tarixi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(cargos && cargos.length > 0) { %>
                        <% cargos.forEach(cargo => { %>
                            <tr>
                                <td><span class="text-muted fw-semibold">#<%= cargo.id %></span></td>
                                <td><strong class="text-dark"><%= cargo.title %></strong></td>
                                <td><span class="badge bg-light text-secondary border px-2 py-1"><%= cargo.cargo_type %></span></td>
                                <td class="fw-medium"><%= cargo.weight ? cargo.weight + ' kq' : '-' %></td>
                                <td class="fw-medium"><%= cargo.volume ? cargo.volume + ' m³' : '-' %></td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <small class="d-flex align-items-center text-muted">
                                            <i class="bi bi-circle-fill text-primary me-2" style="font-size: 8px;"></i> <%= cargo.loading_city %>
                                        </small>
                                        <small class="d-flex align-items-center text-muted">
                                            <i class="bi bi-geo-alt-fill text-danger me-2" style="font-size: 10px;"></i> <%= cargo.unloading_city %>
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-calendar3 me-2"></i> 
                                        <small><%= cargo.latest_pickup_date %></small>
                                    </div>
                                </td>
                                <td>
                                    <% if(cargo.status === 'PENDING') { %>
                                        <span class="badge" style="background-color: #fffbeb; color: #b45309; border: 1px solid #fde68a; padding: 6px 10px; border-radius: 6px;">Gözləyir</span>
                                    <% } else if(cargo.status === 'APPROVED') { %>
                                        <span class="badge" style="background-color: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 6px 10px; border-radius: 6px;">Təsdiqlənib</span>
                                    <% } else { %>
                                        <span class="badge bg-danger rounded-pill px-3"><%= cargo.status %></span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2 align-items-center">
                                        <small class="text-muted"><%= new Date(cargo.created_at).toLocaleDateString('az-AZ', { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
                                        <form action="/dashboard/elan/sil/<%= cargo.id %>" method="POST" onsubmit="return confirm('Bu elanı silmək istədiyinizə əminsiniz?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>