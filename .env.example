POSTGRES_USER=logistika
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=logistika_prod

# Must use the SAME password as POSTGRES_PASSWORD.
# Postgres only applies POSTGRES_* on FIRST init of the data volume.
# If you changed the password later and get Prisma P1000, either restore the
# original password OR delete /datastore/logistika/postgres-new (wipes DB).
DATABASE_URL=postgresql://logistika:replace-with-strong-postgres-password@postgres:5432/logistika_prod?schema=public

JWT_SECRET=replace-with-32-plus-char-jwt-secret
NEXTAUTH_SECRET=replace-with-32-plus-char-nextauth-secret
SESSION_SECRET=replace-with-32-plus-char-session-secret

PUBLIC_SITE_HOST=tranzit.az
PORTAL_HOST=portal.tranzit.az
ADMIN_HOST=admin.tranzit.az

NEXTAUTH_URL=https://tranzit.az
NEXT_PUBLIC_APP_URL=https://tranzit.az
CORS_ORIGIN=https://tranzit.az,https://portal.tranzit.az,https://admin.tranzit.az
